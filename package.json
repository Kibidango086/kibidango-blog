{
  "name": "kibidango-blog",
  "module": "src/app.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run build:css && bun --hot run src/dev.ts",
    "build:css": "bunx tailwindcss -i src/styles/globals.css -o public/styles/globals.css && bun run src/build-embed.ts && bun run src/build-assets.ts",
    "build": "bun run build:css",
    "start": "bun run build && bun run src/dev.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "latest",
    "tailwindcss": "^4.3.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/html": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@sinclair/typebox": "^0.34.49",
    "elysia": "^1.4.28",
    "fast-xml-parser": "^5.8.0",
    "front-matter": "^4.0.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^18.0.4"
  }
}
